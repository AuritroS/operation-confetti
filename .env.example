# Copy to .env and fill in. .env is gitignored.
# The DB password is stored raw here; scripts URL-encode it when building the
# connection string, so special characters like / ? , @ are safe.

SUPABASE_PROJECT_REF=zzgiojqublxhbyipyapd
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_URL=https://zzgiojqublxhbyipyapd.supabase.co

# Dashboard > Project Settings > API keys
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare (only needed for deploys; wrangler login can supply these instead)
CLOUDFLARE_ACCOUNT_ID=
